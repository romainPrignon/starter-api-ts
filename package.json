{
  "name": "starter-api-ts",
  "version": "0.5.0",
  "description": "starting point of a new api",
  "private": true,
  "engines": {
    "node": "^18.17.0",
    "npm": "^9.6.7"
  },
  "types": "type/index.d.ts",
  "scripts": {
    "build": "rm -rf dist/ && tsc",
    "build:dev": "tsc --noEmit --pretty",
    "lint": "eslint src/**/*.ts",
    "start:local": "NODE_ENV=development nodemon -w src -e ts -x 'ts-node --require dotenv/config ./src/index.ts'",
    "start:dev": "NODE_ENV=development node --require dotenv/config dist/index.js dotenv_config_path=.env.dev",
    "start:prod": "NODE_ENV=production node --require dotenv/config dist/index.js dotenv_config_path=.env.prod",
    "test": "jest --forceExit",
    "test:coverage": "npm run test -- --coverage",
    "test:watch": "npm run test -- --watch"
  },
  "dependencies": {
    "body-parser": "1.18.3",
    "compression": "1.7.2",
    "config": "1.30.0",
    "cors": "2.8.4",
    "dotenv": "5.0.1",
    "express": "4.16.3",
    "helmet": "3.12.1",
    "lodash": "4.17.10"
  },
  "devDependencies": {
    "@types/compression": "0.0.36",
    "@types/config": "0.0.34",
    "@types/cors": "2.8.4",
    "@types/express": "4.11.1",
    "@types/helmet": "0.0.37",
    "@types/jest": "^29.5.5",
    "@types/lodash": "4.14.109",
    "@types/node": "^18.17.0",
    "@typescript-eslint/eslint-plugin": "^6.7.3",
    "@typescript-eslint/parser": "^6.7.3",
    "eslint": "^8.50.0",
    "eslint-config-standard": "^12.0.0",
    "eslint-plugin-import": "^2.16.0",
    "eslint-plugin-node": "^8.0.1",
    "eslint-plugin-promise": "^4.0.1",
    "eslint-plugin-standard": "^4.0.0",
    "jest": "^29.7.0",
    "jest-config": "23.6.0",
    "nodemon": "1.17.4",
    "ts-jest": "^29.1.1",
    "ts-node": "6.0.3",
    "typescript": "^5.2.2"
  },
  "optionalDependencies": {
    "husky": "^8.0.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint && npm run build:dev && npm run test:coverage"
    }
  }
}
